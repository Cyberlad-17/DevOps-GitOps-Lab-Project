pipeline {
    agent any

    environment {
        REGISTRY = "localhost:5000"
        IMAGE_NAME = "flask-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        GIT_EMAIL = "jenkins@example.com"
        GIT_NAME = "Jenkins"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Environment') {
            steps {
                sh '''
                pwd
                ls -la
                docker version
                git branch
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build \
                -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                ./app
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Update Helm Chart') {
            steps {
                sh '''
                sed -i "s/^  tag:.*/  tag: ${IMAGE_TAG}/" helm/flask-app/values.yaml
                '''
            }
        }

        stage('Commit Git Changes') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-pat-token',
                    usernameVariable: 'USERNAME',
                    passwordVariable: 'TOKEN'
                )]) {

                    sh '''
                    git config user.email "${GIT_EMAIL}"
                    git config user.name "${GIT_NAME}"

                    git add helm/flask-app/values.yaml

                    git diff --cached --quiet || git commit -m "Update image tag to ${IMAGE_TAG}"

                    git remote set-url origin https://${USERNAME}:${TOKEN}@github.com/Cyberlad-17/DevOps-GitOps-Lab-Project.git

                    git push origin HEAD:main
                    '''
                }
            }
        }

    }

    post {

        success {
            echo "Pipeline Completed Successfully"
        }

        failure {
            echo "Pipeline Failed"
        }

    }
}
